<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" prefWidth="400.0" prefHeight="500.0"
  xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
  stylesheets="@/styles.css"
  fx:controller="ResetPasswordController">

  <padding>
    <Insets top="20.0" right="30.0" bottom="20.0" left="30.0" />
  </padding>

  <!-- 08/13/2026 - MQ - Implement Reset Password - Add Reset Password Label -->
  <Label text="Reset Password">
    <font>
      <Font name="System Bold" size="22.0" />
    </font>
  </Label>

  <!-- 08/13/2026 - MQ - Implement Reset Password - Add Status Message Label -->
  <Label fx:id="statusLabel" wrapText="true" alignment="CENTER" />

  <!-- 08/13/2026 - MQ - Implement Reset Password - Add Username Field -->
  <VBox spacing="5.0">
    <Label text="Username:" />
    <HBox spacing="10.0">
      <TextField fx:id="usernameField" promptText="Enter your username" HBox.hgrow="ALWAYS" />
      <Button text="Get Question" onAction="#handleFetchQuestion" />
    </HBox>
  </VBox>

  <!-- 08/13/2026 - MQ - Implement Reset Password - Add security question VBox container -->
  <VBox fx:id="step2Container" spacing="12.0" visible="false" managed="false">

    <VBox spacing="5.0">
      <Label text="Security Question:" style="-fx-font-weight: bold;" />
      <Label fx:id="securityQuestionLabel" wrapText="true" style="-fx-italic: true;" />
    </VBox>

    <VBox spacing="5.0">
      <Label text="Answer:" />
      <TextField fx:id="answerField" promptText="Enter your answer" />
    </VBox>

    <VBox spacing="5.0">
      <Label text="New Password:" />
      <PasswordField fx:id="newPasswordField" promptText="Enter new password" />
    </VBox>

    <VBox spacing="5.0">
      <Label text="Confirm New Password:" />
      <PasswordField fx:id="confirmPasswordField" promptText="Re-enter new password" />
    </VBox>

    <!-- 08/13/2026 - MQ - Implement Reset Password - Use style from style sheet -->
    <Button text="Reset Password" onAction="#handleResetPassword"
      maxWidth="Infinity" styleClass="password-reset-button" />

  </VBox>

  <HBox alignment="CENTER" spacing="10.0">
    <Button text="Cancel" onAction="#handleCancel" />
  </HBox>

</VBox>