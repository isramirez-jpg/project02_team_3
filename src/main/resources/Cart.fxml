<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="CartController"
      alignment="CENTER"
      spacing="20"
      prefWidth="600"
      prefHeight="450">

    <Label text="Shopping Cart"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <TableView fx:id="cartTable"
               prefHeight="280"
               prefWidth="550">

        <columns>
            <TableColumn fx:id="productColumn"
                         text="Product"
                         prefWidth="180"/>

            <TableColumn fx:id="priceColumn"
                         text="Unit Price"
                         prefWidth="110"/>

            <TableColumn fx:id="quantityColumn"
                         text="Quantity"
                         prefWidth="100"/>

            <TableColumn fx:id="totalColumn"
                         text="Item Total"
                         prefWidth="120"/>
        </columns>

    </TableView>

    <Label fx:id="subtotalLabel"
           text="Subtotal: $0.00"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <HBox alignment="CENTER"
          spacing="10">

        <Button text="Remove Selected"
                onAction="#removeSelected"/>

        <Button text="Checkout"
                onAction="#openCheckout"/>

        <Button text="Back"
                onAction="#goBack"/>

    </HBox>

</VBox>