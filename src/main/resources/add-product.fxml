<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="AddProductController"
      spacing="12.0"
      alignment="TOP_CENTER">

    <padding>
        <Insets top="20.0"
                right="20.0"
                bottom="20.0"
                left="20.0"/>
    </padding>

    <Label text="Add New Product"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <GridPane hgap="10.0" vgap="10.0">

        <Label text="Product Name:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <TextField fx:id="productNameField"
                   promptText="Enter product name"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>


        <Label text="Category:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <ComboBox fx:id="categoryComboBox"
                  promptText="Select category"
                  prefWidth="250.0"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="1"/>


        <Label text="Description:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <TextField fx:id="descriptionField"
                   promptText="Enter description"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>


        <Label text="Price:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>

        <TextField fx:id="priceField"
                   promptText="Example: 29.99"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3"/>


        <Label text="Gender:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="4"/>

        <ComboBox fx:id="genderComboBox"
                  promptText="Select gender"
                  prefWidth="250.0"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="4"/>


        <Label text="Color:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="5"/>

        <TextField fx:id="colorField"
                   promptText="Enter color"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="5"/>


        <Label text="Size:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="6"/>

        <ComboBox fx:id="sizeComboBox"
                  promptText="Select size"
                  prefWidth="250.0"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="6"/>


        <Label text="Stock Quantity:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="7"/>

        <TextField fx:id="stockQuantityField"
                   promptText="Enter quantity"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="7"/>


        <Label text="Image Path:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="8"/>

        <TextField fx:id="imagePathField"
                   promptText="Optional image path"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="8"/>

    </GridPane>

    <Label fx:id="statusLabel"
           wrapText="true"/>

    <HBox spacing="10.0"
          alignment="CENTER">

        <Button text="Add Product"
                fx:id="addProductButton"
                onAction="#handleAddProduct"/>

        <Button text="Clear"
                onAction="#handleClear"/>

        <Button text="Back"
                onAction="#handleBack"/>

    </HBox>

</VBox>