<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ProductDetailController"
            prefWidth="800.0"
            prefHeight="550.0">

    <!-- Header -->
    <top>
        <VBox alignment="CENTER" spacing="5.0">
            <padding>
                <Insets top="20.0"
                        right="20.0"
                        bottom="15.0"
                        left="20.0"/>
            </padding>

            <Label text="Product Details"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <!-- Product Information -->
    <center>
        <HBox alignment="CENTER"
              spacing="40.0">

            <padding>
                <Insets top="20.0"
                        right="40.0"
                        bottom="20.0"
                        left="40.0"/>
            </padding>

            <!-- Product Image -->
            <VBox alignment="CENTER"
                  spacing="10.0"
                  prefWidth="350.0">

                <ImageView fx:id="productImageView"
                           fitWidth="300.0"
                           fitHeight="350.0"
                           preserveRatio="true"/>

            </VBox>

            <!-- Product Details -->
            <VBox spacing="15.0"
                  prefWidth="320.0">

                <Label fx:id="productNameLabel"
                       text="Product Name"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

                <Label fx:id="priceLabel"
                       text="0.00"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #146a9b;"/>

                <Label text="Description"/>

                <Label fx:id="descriptionLabel"
                       text="Product description"
                       wrapText="true"
                       maxWidth="300.0"/>

                <Label fx:id="genderLabel"
                       text="Gender: "/>

                <Label fx:id="colorLabel"
                       text="Color: "/>

                <Label fx:id="sizeLabel"
                       text="Size: "/>

                <Label fx:id="stockLabel"
                       text="Stock: "/>

                <Button fx:id="addToCartButton"
                        text="Add to Cart"
                        onAction="#handleAddToCart"
                        prefWidth="180.0"
                        prefHeight="40.0"
                        style="-fx-background-color: #146a9b; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <Button fx:id="viewCartButton"
                        text="View Cart"
                        onAction="#handleViewCart"
                        prefWidth="180.0"
                        prefHeight="40.0"
                        style="-fx-background-color: #146a9b; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </VBox>

        </HBox>
    </center>

    <!-- Bottom -->
    <bottom>
        <HBox alignment="CENTER_LEFT">
            <padding>
                <Insets top="10.0"
                        right="30.0"
                        bottom="20.0"
                        left="30.0"/>
            </padding>

            <Button fx:id="backButton"
                    text="← Back to Catalog"
                    onAction="#handleBack"
                    prefWidth="140.0"/>
        </HBox>
    </bottom>

</BorderPane>