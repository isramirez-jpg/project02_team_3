<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="CheckoutController"
      alignment="CENTER"
      spacing="16">

    <padding>
        <Insets top="24"
                right="24"
                bottom="24"
                left="24"/>
    </padding>

    <Label fx:id="checkoutTitle"
           text="Checkout"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Label text="Review your cart before placing your order."/>
    <TableView fx:id="checkoutTable"
               prefWidth="540"
               prefHeight="220">

        <columns>
            <TableColumn fx:id="checkoutProductColumn"
                         text="Product"
                         prefWidth="180"/>

            <TableColumn fx:id="checkoutPriceColumn"
                         text="Unit Price"
                         prefWidth="110"/>

            <TableColumn fx:id="checkoutQuantityColumn"
                         text="Quantity"
                         prefWidth="100"/>

            <TableColumn fx:id="checkoutTotalColumn"
                         text="Item Total"
                         prefWidth="120"/>
        </columns>

    </TableView>

    <Label fx:id="checkoutSubtotalLabel"
           text="Order Total: $0.00"/>

    <Label fx:id="statusLabel"/>

    <Button fx:id="placeOrderButton"
            text="Place Order"
            onAction="#handlePlaceOrder"/>

    <Button text="Back to Cart"
            onAction="#handleBack"/>

</VBox>