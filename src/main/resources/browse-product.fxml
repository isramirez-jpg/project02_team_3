<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="BrowseProductController"
            prefWidth="900.0"
            prefHeight="600.0">

    <!-- Header -->
    <top>
        <VBox alignment="CENTER" spacing="10.0"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets top="20.0"
                        right="25.0"
                        bottom="15.0"
                        left="25.0"/>
            </padding>

            <!-- Title -->
            <Label text="Clothing Catalog"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <!-- Search Row -->
            <HBox alignment="CENTER" spacing="8.0">

                <TextField fx:id="searchTextField"
                           promptText="Search product..."
                           HBox.hgrow="ALWAYS"/>

                <Button fx:id="searchButton"
                        text="Search"
                        onAction="#handleSearch"
                        prefWidth="90.0"/>

            </HBox>

            <!-- Filter Row -->
            <HBox alignment="CENTER" spacing="10.0">

                <Label text="Size:"/>

                <ComboBox fx:id="sizeComboBox"
                          promptText="All Sizes"
                          prefWidth="100.0"/>

                <Label text="Gender:"/>

                <ComboBox fx:id="genderComboBox"
                          promptText="All Genders"
                          prefWidth="100.0"/>

                <Label text="Category:"/>

                <ComboBox fx:id="categoryComboBox"
                          promptText="All Categories"
                          prefWidth="120.0"/>

            </HBox>

        </VBox>
    </top>

    <!-- Product Table -->
    <center>
        <VBox spacing="10.0"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets top="10.0"
                        right="25.0"
                        bottom="10.0"
                        left="25.0"/>
            </padding>

            <Label text="Products"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <TableView fx:id="productTableView"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="productNameColumn"
                                 text="Product"
                                 prefWidth="150.0"/>

                    <TableColumn fx:id="descriptionColumn"
                                 text="Description"
                                 prefWidth="220.0"/>

                    <TableColumn fx:id="genderColumn"
                                 text="Gender"
                                 prefWidth="90.0"/>

                    <TableColumn fx:id="colorColumn"
                                 text="Color"
                                 prefWidth="90.0"/>

                    <TableColumn fx:id="sizeColumn"
                                 text="Size"
                                 prefWidth="70.0"/>

                    <TableColumn fx:id="priceColumn"
                                 text="Price"
                                 prefWidth="90.0"/>

                    <TableColumn fx:id="stockQuantityColumn"
                                 text="Stock"
                                 prefWidth="70.0"/>

                </columns>

            </TableView>

        </VBox>
    </center>

    <!-- Bottom Buttons -->
    <bottom>
        <HBox alignment="CENTER_RIGHT"
              spacing="10.0">

            <padding>
                <Insets top="10.0"
                        right="25.0"
                        bottom="20.0"
                        left="25.0"/>
            </padding>

            <Button fx:id="viewDetailsButton"
                    text="View Details"
                    onAction="#handleViewDetails"
                    prefWidth="120.0"/>

            <Button fx:id="backButton"
                    onAction="#handleBack"
                    text="Back to Main"
                    prefWidth="120.0"/>

        </HBox>
    </bottom>

</BorderPane>