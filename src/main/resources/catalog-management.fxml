<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="CatalogManagementController">

    <!-- Header -->
    <top>
        <VBox alignment="CENTER" spacing="8.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="16.0" right="16.0" bottom="8.0" left="16.0"/>
            </padding>
            <Label text="Clothing Catalog Management" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </VBox>
    </top>


    <!-- Main content -->
    <center>
        <TabPane fx:id="catalogTabPane"
                 tabClosingPolicy="UNAVAILABLE">

            <!-- PRODUCT MANAGEMENT TAB                           -->

            <Tab text="Product Management">

                <BorderPane>

                    <!-- Product Table -->
                    <center>
                        <TableView fx:id="productTable"
                                   prefHeight="400">

                            <columns>

                                <TableColumn fx:id="productIdColumn"
                                             text="ID"
                                             prefWidth="55"/>

                                <TableColumn fx:id="productNameColumn"
                                             text="Product Name"
                                             prefWidth="150"/>

                                <TableColumn fx:id="categoryIdColumn"
                                             text="Category"
                                             prefWidth="75"/>

                                <TableColumn fx:id="priceColumn"
                                             text="Price"
                                             prefWidth="75"/>

                                <TableColumn fx:id="genderColumn"
                                             text="Gender"
                                             prefWidth="75"/>

                                <TableColumn fx:id="colorColumn"
                                             text="Color"
                                             prefWidth="75"/>

                                <TableColumn fx:id="sizeColumn"
                                             text="Size"
                                             prefWidth="65"/>

                                <TableColumn fx:id="stockColumn"
                                             text="Stock"
                                             prefWidth="65"/>

                            </columns>

                        </TableView>
                    </center>


                    <!-- Product Buttons -->
                    <bottom>
                        <HBox spacing="10"
                              alignment="CENTER_LEFT">

                            <padding>
                                <Insets top="10"
                                        right="10"
                                        bottom="10"
                                        left="10"/>
                            </padding>

                            <Button text="Add Product"
                                    onAction="#handleAddProduct"/>

                            <Button text="Edit Product"
                                    onAction="#handleEditProduct"/>

                            <Button text="Delete Product"
                                    onAction="#handleDeleteProduct"/>

                            <Button text="Refresh"
                                    onAction="#handleRefreshProducts"/>

                        </HBox>
                    </bottom>

                </BorderPane>

            </Tab>


            <!-- CATEGORY MANAGEMENT TAB                           -->

            <Tab text="Category Management">

                <BorderPane>

                    <!-- Category Table -->
                    <center>
                        <TableView fx:id="categoryTable"
                                   prefHeight="400">

                            <columns>

                                <TableColumn fx:id="categoryIdColumn"
                                             text="ID"
                                             prefWidth="70"/>

                                <TableColumn fx:id="categoryNameColumn"
                                             text="Category Name"
                                             prefWidth="180"/>

                                <TableColumn fx:id="categoryDescriptionColumn"
                                             text="Description"
                                             prefWidth="300"/>

                            </columns>

                        </TableView>
                    </center>


                    <!-- Category Buttons -->
                    <bottom>
                        <HBox spacing="10"
                              alignment="CENTER_LEFT">

                            <padding>
                                <Insets top="10"
                                        right="10"
                                        bottom="10"
                                        left="10"/>
                            </padding>

                            <Button text="Add Category"
                                    onAction="#handleAddCategory"/>

                            <Button text="Edit Category"
                                    onAction="#handleEditCategory"/>

                            <Button text="Delete Category"
                                    onAction="#handleDeleteCategory"/>

                            <Button text="Refresh"
                                    onAction="#handleRefreshCategories"/>

                        </HBox>
                    </bottom>

                </BorderPane>

            </Tab>

        </TabPane>
    </center>


    <!-- Bottom navigation -->
    <bottom>
        <HBox spacing="10"
              alignment="CENTER_RIGHT">

            <padding>
                <Insets top="10"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <Button text="Back"
                    onAction="#handleBack"/>

        </HBox>
    </bottom>

</BorderPane>